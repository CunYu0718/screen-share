{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SCREEN_SHARE_BUILD_DESKTOP": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "Local core development",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "desktop",
      "displayName": "Local Qt desktop development",
      "inherits": "dev",
      "cacheVariables": {
        "SCREEN_SHARE_BUILD_DESKTOP": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "Windows CI",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 4
    },
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "jobs": 4
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "configuration": "Debug",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
